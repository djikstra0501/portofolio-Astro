---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Server Status">
  <main class="max-w-2xl mx-auto p-8">
    <h1 class="text-2xl font-bold mb-6">Infrastructure Status</h1>
    <div id="status-grid" class="grid gap-4">
      <p>Fetching metrics from internal bridge...</p>
    </div>
  </main>
</Layout>

<script>
  interface SanitizedNode {
    name: string;
    online: boolean;
    cpu: string;
    ram: string;
    uptime: number;
  }

  async function fetchStatus() {
    const res = await fetch('/api/status');
    const nodes: SanitizedNode[] = await res.json();
    const grid = document.getElementById('status-grid');
    
    if (grid) {
      grid.innerHTML = nodes.map(node => `
        <div class="p-4 border rounded-lg flex justify-between items-center bg-zinc-900">
          <div>
            <h2 class="font-mono text-lg">${node.name}</h2>
            <p class="text-sm text-zinc-400">Uptime: ${node.uptime}h</p>
          </div>
          <div class="text-right">
            <span class="${node.online ? 'text-green-500' : 'text-red-500'} font-bold">
              ● ${node.online ? 'ONLINE' : 'OFFLINE'}
            </span>
            <div class="text-xs text-zinc-500 mt-1">CPU: ${node.cpu}% | RAM: ${node.ram}%</div>
          </div>
        </div>
      `).join('');
    }
  }
  fetchStatus();
</script>