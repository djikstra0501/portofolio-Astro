---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Carousel from "../components/Carousel.astro";
import Footer from "../components/Footer.astro";
import { projects } from "../data/projects";
---

<Layout title="Dananjaya | Backend & ML Engineer">
  <Hero />

  <Section title="Projects">
    <Carousel projects={projects} />
  </Section>

  <Section title="Research Interests">
    <ul>
      <li>Computer Vision Optimization</li>
      <li>Forecasting & Time Series</li>
      <li>Decision Support Systems</li>
      <li>Applied Machine Learning</li>
      <li>Backend System Architecture</li>
    </ul>
  </Section>

  <Section title="Currently Learning">
    <p>
      Exploring Go for backend performance-oriented services and concurrent systems.
    </p>
  </Section>
  <Footer />
</Layout>