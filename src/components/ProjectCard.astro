---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Project } from "../data/projects";
import { isPlaceholder } from "../data/projects";

type Props = Project & { index: number };
const {
  id,
  title,
  kind,
  year,
  role,
  summary,
  detail,
  metrics,
  tech,
  links,
  status,
  featured,
  imageAlt,
  index,
} = Astro.props as Props;
const num = String(index + 1).padStart(2, "0");

const covers = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/projects/*.{png,jpg,jpeg,webp,avif,PNG,JPG,JPEG,WEBP,AVIF}",
  { eager: true },
);
const cover = Object.entries(covers).find(
  ([path]) => path.split("/").pop()?.replace(/\.[^.]+$/, "") === id,
)?.[1].default;

const shownLinks = (links ?? []).filter(
  (l) => import.meta.env.DEV || !isPlaceholder(l.href),
);
---

<article class={`card${featured ? " featured" : ""}`}>
  <div class="body">
    <header class="head">
      <span class="tag num">{num}</span>
      <span class="tag kind">{kind}</span>
      <span class="tag year">{year}</span>
    </header>

    <h3>{title}</h3>
    <p class="role tag">{role}</p>

    <p class="summary">{summary}</p>
    <p class="detail">{detail}</p>

    {
      status && (
        <p class="status">
          <span class="dot" />
          {status}
        </p>
      )
    }

    <dl class="metrics">
      {
        metrics.map((m) => (
          <div class="metric">
            <dt>{m.label}</dt>
            <dd class={m.value === "TODO" ? "todo" : ""}>{m.value}</dd>
          </div>
        ))
      }
    </dl>

    <footer class="foot">
      <ul class="tech">
        {tech.map((t) => <li>{t}</li>)}
      </ul>
      {
        shownLinks.length > 0 && (
          <ul class="links">
            {shownLinks.map((l) =>
              isPlaceholder(l.href) ? (
                <li>
                  <a href="#" class="todo" title={`Fill in: ${l.href}`}>
                    {l.label} ↗
                  </a>
                </li>
              ) : (
                <li>
                  <a href={l.href} target="_blank" rel="noopener noreferrer">
                    {l.label} ↗
                  </a>
                </li>
              ),
            )}
          </ul>
        )
      }
    </footer>
  </div>

  <div class="media">
    {
      cover ? (
        <div class="cover">
          <Image
            src={cover}
            alt={imageAlt ?? title}
            widths={[480, 800, 1200]}
            sizes="(min-width: 62rem) 24rem, 100vw"
            loading={index === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </div>
      ) : (
        <div class="cover generated" aria-hidden="true" style={`--shift:${(index % 3) * 5}%`}>
          <span class="box">
            <span class="box-label">{kind.toLowerCase()}</span>
          </span>
        </div>
      )
    }
  </div>
</article>
<style>
  .card {
    position: relative;
    display: grid;
    gap: 1.5rem;
    border: 1px solid var(--line-soft);
    background: linear-gradient(180deg, var(--panel) 0%, var(--ink) 100%);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .media {
    order: -1;
  }

  @media (min-width: 62rem) {
    .card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      gap: 2.25rem;
      align-items: start;
    }

    .media {
      order: 0;
    }
  }

  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line-soft);
    background: var(--ink);
  }

  /* <Image> is a component, so its <img> does not get this file's scope. */
  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .generated {
    background-color: var(--panel);
    background-image:
      linear-gradient(var(--line-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .box {
    position: absolute;
    inset: 24% 16% 20% calc(18% + var(--shift, 0%));
    border: 1px solid var(--signal);
  }

  .box-label {
    position: absolute;
    top: -1.35rem;
    left: -1px;
    padding: 0.12rem 0.5rem;
    background: var(--signal);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
  }

  .card:hover {
    border-color: rgba(232, 179, 60, 0.4);
    transform: translateY(-2px);
  }

  .card.featured {
    border-color: rgba(232, 179, 60, 0.3);
  }

  .card.featured::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 3px;
    height: 42px;
    background: var(--signal);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.1rem;
  }

  .num {
    color: var(--signal);
  }

  .kind {
    color: var(--bone);
    border: 1px solid var(--line);
    padding: 0.15rem 0.5rem;
  }

  .year {
    margin-left: auto;
  }

  h3 {
    font-size: clamp(1.35rem, 3.2vw, 1.75rem);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .role {
    color: var(--mute);
    text-transform: none;
    letter-spacing: 0.02em;
    margin-bottom: 1.25rem;
  }

  .summary {
    font-size: 1.02rem;
    margin-bottom: 0.9rem;
    max-width: 66ch;
  }

  .detail {
    color: var(--mute);
    font-size: 0.94rem;
    max-width: 70ch;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ndvi);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ndvi);
    box-shadow: 0 0 0 3px rgba(95, 185, 138, 0.15);
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2.25rem;
    margin: 1.5rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--line-soft);
  }

  .metric dt {
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .metric dd {
    margin: 0.15rem 0 0;
    font-family: var(--mono);
    font-size: 0.95rem;
    color: var(--bone);
  }

  .metric dd.todo {
    color: var(--alert);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .tech,
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
  }

  .tech li {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--mute);
    border: 1px solid var(--line-soft);
    padding: 0.18rem 0.5rem;
  }

  .links {
    gap: 1rem;
  }

  .links a {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--signal);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .links a:hover {
    border-bottom-color: var(--signal);
  }

  .links a.todo {
    color: var(--alert);
  }
</style>