---
import { capabilities } from "../data/profile";
---

<div class="grid">
  {
    capabilities.map((c) => (
      <div class="cap">
        <h3>{c.title}</h3>
        <p class="note">{c.note}</p>
        <ul>
          {c.evidence.map((e) => (
            <li>{e}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }

  .cap {
    background: var(--ink);
    padding: 1.6rem;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .note {
    color: var(--mute);
    font-size: 0.88rem;
    margin-bottom: 1rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }

  li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.88rem;
    color: var(--bone);
    line-height: 1.45;
  }

  li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 1px;
    background: var(--signal);
  }
</style>
