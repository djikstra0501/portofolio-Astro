---
import { profile } from "../data/profile";
const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="inner">
    <p class="tag label">Open to roles · 2026 graduate</p>
    <h2>Looking for someone who can take a model from data to deployed.</h2>
    <p class="sub">
      Based in {profile.location}. Happy to talk about computer vision, edge
      inference, or backend work.
    </p>

    <ul class="links">
      <li><a href={`mailto:${profile.email}`}>Email</a></li>
      <li>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={profile.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </li>
      <li><a href={profile.resume}>CV (PDF)</a></li>
    </ul>

    <p class="copyright tag">© {year} {profile.fullName}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line-soft);
    padding: clamp(3.5rem, 10vh, 6rem) 0 3rem;
  }

  .label {
    color: var(--ndvi);
    margin-bottom: 0.75rem;
  }

  h2 {
    font-size: clamp(1.5rem, 4.5vw, 2.4rem);
    font-weight: 600;
    max-width: 22ch;
    margin-bottom: 1rem;
  }

  .sub {
    color: var(--mute);
    max-width: 48ch;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 2rem 0 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .links a {
    display: inline-block;
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--line);
    transition:
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .links a:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  .copyright {
    color: var(--faint);
  }
</style>
