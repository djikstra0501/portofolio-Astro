---
const socialLinks = {
  linkedin: "https://www.linkedin.com/in/i-kadek-dipastra-arka-dananjaya/",
  github: "https://github.com/djikstra0501" 
};

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <p class="footer-text">
      <span class="light-text">Want to know me better?</span>
      <span class="connect-text">Let's connect</span>
    </p>
    
    <div class="social-links">
      <a 
        href={socialLinks.linkedin} 
        target="_blank" 
        rel="noopener noreferrer"
        class="social-link"
        aria-label="Visit LinkedIn profile"
      >
        <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/>
        </svg>
      </a>
      
      <a 
        href={socialLinks.github} 
        target="_blank" 
        rel="noopener noreferrer"
        class="social-link"
        aria-label="Visit GitHub profile"
      >
        <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
      </a>
    </div>
    
    <p class="copyright">
      © {currentYear} Dananjaya.
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 5rem;
    padding: 2rem 0 1.5rem;
    border-top: 1px solid rgba(37, 52, 73, 0.3);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .footer-text {
    font-size: 1rem;
    color: var(--text-tertiary);
    font-weight: 400;
    letter-spacing: 0.3px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .footer-text:hover {
    opacity: 1;
  }

  .light-text {
    font-weight: 300;
  }

  .connect-text {
    color: var(--text-secondary);
    font-weight: 500;
    position: relative;
    cursor: default;
  }

  .connect-text::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-secondary), transparent);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .footer-text:hover .connect-text::after {
    transform: scaleX(1);
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    align-items: center;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--text-tertiary);
    transition: all 0.2s ease;
    padding: 0.25rem;
    opacity: 0.6;
  }

  .social-link:hover {
    opacity: 1;
    color: var(--accent-secondary);
    transform: translateY(-2px);
  }

  .social-icon {
    width: 20px;
    height: 20px;
    transition: all 0.2s ease;
  }

  .social-link:hover .social-icon {
    filter: drop-shadow(0 2px 4px rgba(45, 127, 193, 0.2));
  }

  .copyright {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    opacity: 0.5;
    letter-spacing: 0.5px;
    margin-top: 0.5rem;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .footer {
      margin-top: 4rem;
      padding: 1.5rem 0 1rem;
    }

    .footer-text {
      font-size: 0.9rem;
    }

    .social-icon {
      width: 18px;
      height: 18px;
    }

    .social-links {
      gap: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .footer-text {
      font-size: 0.85rem;
      flex-direction: column;
      gap: 0.25rem;
    }

    .social-icon {
      width: 16px;
      height: 16px;
    }

    .copyright {
      font-size: 0.7rem;
    }
  }

  /* Optional: Very subtle hover effect on the entire footer */
  .footer {
    transition: border-color 0.2s ease;
  }

  .footer:hover {
    border-top-color: rgba(45, 127, 193, 0.2);
  }
</style>