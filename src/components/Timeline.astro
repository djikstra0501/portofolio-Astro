---
import { timeline } from "../data/profile";
---

<ol class="timeline">
  {
    timeline.map((t) => (
      <li>
        <span class="year tag">{t.year}</span>
        <div class="body">
          <h3>
            {t.title} <span class="org">· {t.org}</span>
          </h3>
          <p>{t.note}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.25rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line-soft);
  }

  li:last-child {
    border-bottom: 0;
  }

  .year {
    color: var(--signal);
    padding-top: 0.25rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .org {
    color: var(--mute);
    font-weight: 400;
  }

  p {
    color: var(--mute);
    font-size: 0.9rem;
  }

  @media (max-width: 520px) {
    li {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
