---
import "../styles/global.css";
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/daya-logo-main.svg" />
  </head>
  <body>
    <header class="navbar">
      <div class="logo">
        <img src="/daya-logo-main.svg" alt="Daya Logo" />
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>